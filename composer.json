{
    "name": "slam/php-validatore-fattura-elettronica",
    "description": "Validatore fattura elettronica",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Filippo Tessarotto",
            "email": "zoeslam@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^7.4",
        "ext-dom": "*",
        "ext-libxml": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-phpunit": "^2",
        "phpstan/phpstan-strict-rules": "^2",
        "phpunit/phpunit": "*",
        "slam/php-cs-fixer-extensions": "*"
    },
    "autoload": {
        "psr-4": {
            "SlamFatturaElettronica\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SlamFatturaElettronica\\Tests\\": "tests/"
        }
    }
}
